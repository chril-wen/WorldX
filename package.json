{
  "name": "own-world",
  "version": "0.1.0",
  "private": true,
  "repository": "git@github.com:YGYOOO/WorldX.git",
  "type": "module",
  "scripts": {
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ../orchestrator && npm install && cd ../generators && npm install",
    "create": "node orchestrator/src/index.mjs",
    "cli": "node apps/cli/src/index.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "compare:models": "node scripts/compare-models.mjs",
    "demo:region-overlay": "node generators/map/src/demo-region-overlay.mjs",
    "generate:map": "node generators/map/src/index.mjs",
    "generate:character": "node generators/character/src/index.mjs",
    "timeline": "tsx scripts/timeline.mjs",
    "rules": "tsx scripts/rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:core && npm run typecheck:client-core && npm run typecheck:server && npm run typecheck:client && npm run typecheck:plugins",
    "typecheck:core": "cd packages/core && tsc --noEmit",
    "typecheck:client-core": "cd packages/client-core && tsc --noEmit",
    "typecheck:server": "cd server && tsc --noEmit",
    "typecheck:client": "cd client && tsc --noEmit",
    "typecheck:plugins": "tsc --noEmit -p tsconfig.plugins.json",
    "build": "npm run build:core && npm run build:client-core && npm run build:server",
    "build:core": "cd packages/core && tsc -p tsconfig.json",
    "build:client-core": "cd packages/client-core && tsc -p tsconfig.json",
    "build:server": "cd server && tsc",
    "check": "npm run typecheck && npm run test"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
